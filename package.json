{
  "name": "domainApps",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx server/index.ts\" \"vite\"",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "eslint": "eslint .",
    "html": "html-validate index.html \"public/frames/**/*.html\"",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.server.json --pretty false",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
